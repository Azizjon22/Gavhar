# ─────────────────────────────────────────────────────────────────────────────
# Gavhar — muhit o'zgaruvchilari
# `pnpm setup:env` shu fayldan .env yaratadi va {{hex:NOM:BAYT}} belgilarini
# kriptografik tasodifiy qiymatlar bilan almashtiradi.
# ─────────────────────────────────────────────────────────────────────────────

# ── Umumiy ───────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Tashkent
LOG_LEVEL=debug

# ── API (backend) ────────────────────────────────────────────────────────────
API_PORT=4100
# Frontend manzili: CORS faqat shu origin'ga ruxsat beradi.
APP_URL=http://localhost:5180
SWAGGER_ENABLED=true

# ── Frontend ─────────────────────────────────────────────────────────────────
WEB_PORT=5180
# Dev rejimida Vite /api so'rovlarini backend'ga proxy qiladi.
VITE_API_URL=/api/v1

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=gavhar
POSTGRES_PASSWORD={{hex:pg:24}}
POSTGRES_DB=gavhar
POSTGRES_PORT=5440
DATABASE_URL=postgresql://gavhar:{{hex:pg:24}}@127.0.0.1:5440/gavhar?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD={{hex:redis:24}}
REDIS_PORT=6380
REDIS_URL=redis://:{{hex:redis:24}}@127.0.0.1:6380/0

# ── Auth va xavfsizlik ───────────────────────────────────────────────────────
# Kamida 32 belgi. Production'da har biri alohida, tasodifiy bo'lishi shart.
JWT_ACCESS_SECRET={{hex:jwt:48}}
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Parol hash'iga qo'shiladigan server siri. O'zgartirilsa barcha parollar yaroqsiz bo'ladi!
PASSWORD_PEPPER={{hex:pepper:48}}
# AES-256-GCM kaliti (64 ta hex belgi = 32 bayt). 2FA sirlarini shifrlaydi.
ENCRYPTION_KEY={{hex:enc:32}}
# Production'da (HTTPS) true bo'lishi shart.
COOKIE_SECURE=false
# SUPER_ADMIN uchun ikki bosqichli himoya (authenticator ilovasi) majburiymi.
# Production'da true qoldiring: false bo'lsa, parol o'g'irlansa butun tizim ochiladi.
SUPER_ADMIN_2FA_REQUIRED=true

# ── MinIO / S3 ───────────────────────────────────────────────────────────────
S3_ENDPOINT=http://127.0.0.1:9010
# Brauzer presigned URL orqali murojaat qiladigan tashqi manzil.
S3_PUBLIC_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=gavhar
S3_SECRET_KEY={{hex:s3:24}}
S3_BUCKET_ORIGINALS=gavhar-originals
S3_BUCKET_DERIVATIVES=gavhar-derivatives
S3_FORCE_PATH_STYLE=true
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# ── Seed: birinchi SUPER_ADMIN ───────────────────────────────────────────────
# Birinchi kirishda parolni o'zgartirish majburiy.
SEED_SUPER_ADMIN_EMAIL=admin@gavhar.uz
SEED_SUPER_ADMIN_NAME=Gavhar Admin
SEED_SUPER_ADMIN_PASSWORD=Gavhar!{{hex:seed:8}}aA1
