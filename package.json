{
  "name": "gavhar",
  "version": "0.1.0",
  "private": true,
  "description": "Gavhar to'yxonasi va Gavhar Studio uchun ichki boshqaruv tizimi",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "redis:local": "bash scripts/dev-redis.sh",
    "db:migrate": "pnpm --filter @gavhar/backend run db:migrate",
    "db:deploy": "pnpm --filter @gavhar/backend run db:deploy",
    "db:seed": "pnpm --filter @gavhar/backend run db:seed",
    "user:reset-password": "pnpm --filter @gavhar/backend run user:reset-password",
    "db:studio": "pnpm --filter @gavhar/backend run db:studio",
    "dev": "pnpm -r --parallel run dev",
    "dev:backend": "pnpm --filter @gavhar/backend run dev",
    "dev:frontend": "pnpm --filter @gavhar/frontend run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @gavhar/backend run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.6.0"
  }
}
